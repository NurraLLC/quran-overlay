{
  "name": "quran-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Quran recitation display and OBS overlay with recitation following and English navigation.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "vite build && playwright test",
    "corpus:fetch": "tsx scripts/fetch-corpus.ts",
    "corpus:import": "tsx scripts/import-corpus.ts",
    "corpus:validate": "tsx scripts/validate-corpus.ts",
    "replay": "tsx scripts/replay.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "eval:english": "tsx scripts/eval-english.ts",
    "search:embed": "tsx scripts/build-embeddings.ts",
    "resources:import": "tsx scripts/import-resources.ts",
    "wbw:import": "tsx scripts/import-wbw.ts",
    "fixtures:derived": "tsx scripts/make-derived-fixtures.ts",
    "replay:session": "tsx scripts/replay-session.ts",
    "speedlab": "tsx scripts/speedlab/run.ts",
    "speedlab:audio": "tsx scripts/speedlab/make-audio.ts",
    "speedlab:hosted": "tsx scripts/speedlab/hosted.ts",
    "pool:add": "tsx scripts/sponsor-pool.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@huggingface/transformers": "^4.3.0",
    "@soniox/client": "^2.3.0",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
