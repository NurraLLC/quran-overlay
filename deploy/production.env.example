# Copy to deploy/production.env (git-ignored) and fill in. Only the app reads this file;
# Caddy receives QO_DOMAIN alone.

# The name this server answers to, without https:// (Caddy gets its certificate for it; point its
# DNS A record at this server first).
QO_DOMAIN=quran.example.org
# Where people open it. On its own domain: https:// plus QO_DOMAIN, and leave the next two empty.
QO_PUBLIC_ORIGIN=https://quran.example.org
# Under a path of another site, e.g. nurra.org/quran-reader (see docs/DEPLOY.md):
#   QO_DOMAIN=reader-origin.nurra.org  QO_PUBLIC_ORIGIN=https://nurra.org
#   QO_BASE_PATH=/quran-reader         QO_EXTRA_HOSTS=reader-origin.nurra.org
QO_BASE_PATH=
QO_EXTRA_HOSTS=

# Speech recognition (required). Use a key made for this site, with a spending limit set at Soniox.
SONIOX_API_KEY=
# Spoken requests and meaning search (recommended). Set a credit limit at OpenRouter.
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Listening is free for everyone from one pool of sponsored hours that sadaqah (and you) fill:
# the pool controls listening admission, not the provider's dollar bill. Verify provider-side
# spending controls too. Fill it at launch (see docs/LAUNCH.md):
#   docker compose ... exec app npx tsx scripts/sponsor-pool.ts 100 launch
# Each person's daily share of the sponsored hours, and a network's (clearing cookies is not a new share).
QO_SPONSORED_HOURS_PER_VISITOR_DAY=2
QO_SPONSORED_HOURS_PER_NETWORK_DAY=4

# Donations (optional; leave empty to launch). Test-mode keys first, and live keys only after Quran
# Foundation confirms (docs/DEPLOY.md). Donations fund shared hours, never personal plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
