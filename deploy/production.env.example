# Copy to deploy/production.env (git-ignored) and fill in. Only the app reads this file;
# Caddy receives QO_DOMAIN alone.

# The address people will open, without https:// (point its DNS A record at this server first).
QO_DOMAIN=quran.example.org

# Speech recognition (required). Use a key made for this site, with a spending limit set at Soniox.
SONIOX_API_KEY=
# Spoken requests and meaning search (recommended). Set a credit limit at OpenRouter.
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Listening is free for everyone from one shared pool of hours that gifts (and you) fill: nothing is
# spent that was not put in. Fill it at launch: npm run pool:add -- 100 launch
# Optional personal monthly allowance on top (0 = none; then the caps below it do nothing).
QO_FREE_HOURS_PER_MONTH=0
QO_FREE_HOURS_PER_NETWORK_DAY=2
QO_FREE_HOURS_PER_SERVICE_DAY=25

# Each person's daily share of the shared hours, and a network's (clearing cookies is not a new share).
QO_SPONSORED_HOURS_PER_VISITOR_DAY=2
QO_SPONSORED_HOURS_PER_NETWORK_DAY=4
# The community bar shows this month's gifts against this goal.
QO_POOL_GOAL_HOURS_PER_MONTH=100

# Buying listening time and donations (optional; leave empty to launch free). See docs/DEPLOY.md first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
