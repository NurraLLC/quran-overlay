# Names only. Copy to .env and fill in locally; .env is git-ignored.
# Soniox long-lived key: needs the "Temporary API keys" and realtime transcription permissions.
SONIOX_API_KEY=
# Decision gateway for JEV: typesafe (direct) or openrouter. Only the selected gateway receives requests.
JEV_PROVIDER=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# hybrid (default) | deterministic | jev_required
TRACKER_MODE=hybrid
PORT=4317
